<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Интерфейс Контура с сервера -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />

    <!-- Подключение к серверу (первый запуск, смена адреса) -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_title"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/setup_text"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/field"
                android:hint="@string/setup_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="#5A6375"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/setup_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FF8FA3"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_brand"
                android:text="@string/setup_connect"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Сервер не отвечает -->
    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/error_title"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/retry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_brand"
            android:text="@string/error_retry"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/change"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_outline"
            android:text="@string/error_change"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
