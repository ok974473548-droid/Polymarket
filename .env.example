# Пароль на интерфейс. Пусто — вход без пароля (только если порт открыт лишь на этом компьютере).
WF_UI_PASSWORD=

# База. В Docker не задавайте: она хранится в томе /data и переживает обновления.
# Без Docker: WF_DB_URL=sqlite:///whalefollow.db
# PostgreSQL:
# WF_DB_URL=postgresql://whalefollow:secret@localhost:5432/whalefollow

# Слепая оценка через Claude (этап 7 ТЗ). Без ключа агент работает только по истории кита.
ANTHROPIC_API_KEY=
WF_LLM_MODEL=claude-sonnet-5-5

# Адреса API Polymarket (по умолчанию — публичные)
# WF_GAMMA_URL=https://gamma-api.polymarket.com
# WF_DATA_URL=https://data-api.polymarket.com
# WF_CLOB_URL=https://clob.polymarket.com

# Любой параметр из раздела 14 ТЗ: WF_<ИМЯ_ПАРАМЕТРА>
# WF_EDGE_THRESHOLD=0.03
# WF_MAX_DELAY_S=30
# WF_FUNDER_ALLOWLIST=["0x...биржа", "0x...мост"]

# Уведомления в Telegram (необязательно): токен от @BotFather и ваш chat id (подскажет @userinfobot)
WF_TELEGRAM_BOT_TOKEN=
WF_TELEGRAM_CHAT_ID=
# Адрес интерфейса для ссылок в уведомлениях
WF_PUBLIC_URL=http://localhost:8787

# Переводы USDC из блокчейна Polygon для антисибила (необязательно).
# Вариант 1: ключ Etherscan (https://etherscan.io/myapikey), сеть Polygon — chainid 137
WF_ETHERSCAN_API_KEY=
# Вариант 2: Blockscout — WF_CHAIN_PROVIDER=blockscout и, по возможности, ключ
# WF_CHAIN_PROVIDER=blockscout
# WF_BLOCKSCOUT_API_KEY=

# Коэффициенты букмекеров для спортивных рынков (необязательно): ключ https://the-odds-api.com
# Обновление раз в 12 часов; расход — 1 кредит на вид спорта за обновление.
WF_ODDS_API_KEY=
# WF_ODDS_SPORTS=basketball_nba,americanfootball_nfl,icehockey_nhl,baseball_mlb,soccer_epl,soccer_uefa_champs_league,mma_mixed_martial_arts
# WF_ODDS_INTERVAL_H=12

# Резервные копии базы SQLite: раз в сутки, хранится 7 последних (по умолчанию — папка backups рядом с базой)
# WF_BACKUP_DIR=/data/backups

# Потоки реального времени (WebSocket): сделки китов и стаканы приходят сами, без ожидания опроса.
# off — только опрос (если сеть не пропускает WebSocket, приложение и так переключится само)
# WF_STREAMS=on
